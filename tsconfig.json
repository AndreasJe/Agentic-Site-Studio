{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "spikes/*/src",
    "spikes/*/test",
    ".claude/hooks",
    "apps/*/server",
    "apps/*/scripts",
    "apps/*/test",
    "apps/agent/src"
  ]
}
