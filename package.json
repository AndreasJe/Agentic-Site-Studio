{
  "name": "site-studio",
  "version": "0.1.0-rc.1",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "spikes/*"
  ],
  "scripts": {
    "lint": "biome check . && tsc -p tsconfig.json --noEmit && bun run --cwd apps/studio check",
    "format": "biome check --write .",
    "test:browser": "bun run --filter '*' test:browser",
    "test:worker": "bun run --cwd apps/worker test",
    "test:agent": "bun run --cwd apps/agent test",
    "dev": "bun run --cwd apps/studio dev",
    "build": "bun run --cwd apps/studio build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
