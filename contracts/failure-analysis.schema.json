{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://site-studio.internal/contracts/failure-analysis.schema.json",
  "title": "Failure analysis (plan §13.5 self-healing; decision #21)",
  "description": "What the analyst may return for a failed check run: the issues sorted by cause, severity and confidence with evidence, one recommendation, and optionally a patch for one section. It is data only. Code validates the patch (validateDesign), refuses let-through when a security-floor check failed, and a person sends it as a take.",
  "type": "object",
  "additionalProperties": false,
  "required": ["issues", "recommendation", "patch"],
  "properties": {
    "issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "cause", "severity", "confidence", "evidence"],
        "properties": {
          "check": { "type": "string", "minLength": 1, "maxLength": 40 },
          "cause": { "type": "string", "minLength": 1, "maxLength": 600 },
          "severity": { "enum": ["high", "medium", "low"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        }
      }
    },
    "recommendation": { "enum": ["fix", "hold", "let-through"] },
    "patch": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artboardId", "sectionId", "html", "css"],
          "properties": {
            "artboardId": { "type": "integer", "minimum": 1 },
            "sectionId": { "type": "string", "pattern": "^s-[a-z0-9]{6}$" },
            "html": { "type": "string", "minLength": 1, "maxLength": 60000 },
            "css": { "type": "string", "maxLength": 200000 }
          }
        }
      ]
    }
  }
}
