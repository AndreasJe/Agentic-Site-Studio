{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command.schema.json",
  "title": "Inbox command file",
  "type": "object",
  "required": [
    "command",
    "target",
    "sequence",
    "expires",
    "signatures"
  ],
  "properties": {
    "command": {
      "enum": [
        "freeze",
        "unfreeze",
        "activate",
        "trust-keys"
      ]
    },
    "target": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Strictly increasing per target, one counter for all commands (decisions #26); replays are refused."
    },
    "expires": {
      "type": "string",
      "format": "date-time"
    },
    "args": {
      "type": "object"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/appSignature" },
          { "$ref": "#/$defs/passkeySignature" }
        ]
      },
      "description": "Two from different Admins where the two-person rule requires it."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "enum": [
              "unfreeze",
              "activate",
              "trust-keys"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "signatures": {
            "items": { "$ref": "#/$defs/passkeySignature" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "command": { "const": "trust-keys" } }
      },
      "then": {
        "required": ["args"],
        "properties": { "args": { "$ref": "#/$defs/trustKeysArgs" } }
      }
    },
    {
      "if": {
        "properties": { "command": { "const": "activate" } }
      },
      "then": {
        "required": ["args"],
        "properties": {
          "args": {
            "type": "object",
            "required": ["release"],
            "properties": { "release": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    }
  ],
  "$defs": {
    "appSignature": {
      "type": "object",
      "required": ["by", "value"],
      "properties": {
        "by": { "const": "app" },
        "value": {
          "type": "string",
          "description": "base64url Ed25519 signature by the app's signing key over the command challenge."
        }
      },
      "additionalProperties": false
    },
    "passkeySignature": {
      "type": "object",
      "required": ["by", "adminKeyId", "authenticatorData", "clientDataJSON", "signature"],
      "properties": {
        "by": { "const": "admin-passkey" },
        "adminKeyId": { "type": "string" },
        "authenticatorData": { "type": "string" },
        "clientDataJSON": { "type": "string" },
        "signature": { "type": "string" }
      },
      "additionalProperties": false
    },
    "trustedKey": {
      "type": "object",
      "required": ["keyId", "adminId", "alg", "publicKey"],
      "properties": {
        "keyId": { "type": "string", "description": "base64url credential ID" },
        "adminId": { "type": "string", "description": "The Admin the key belongs to; two-person rules count distinct Admins." },
        "alg": { "enum": [-7, -8, -257] },
        "publicKey": { "type": "string", "description": "base64url COSE public key" }
      },
      "additionalProperties": false
    },
    "trustKeysArgs": {
      "type": "object",
      "properties": {
        "genesis": {
          "type": "boolean",
          "description": "The first keys file at pairing (decisions #25): signed by a key it contains, accepted only after the fingerprint is confirmed on the server."
        },
        "add": { "type": "array", "items": { "$ref": "#/$defs/trustedKey" } },
        "remove": { "type": "array", "items": { "type": "string" } },
        "policy": {
          "type": "object",
          "description": "The two-person rule (plan §13.9): how many different Admins must sign each kind of action.",
          "properties": {
            "releases": { "enum": [1, 2] },
            "keys": { "enum": [1, 2] },
            "domains": { "enum": [1, 2] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "description": "Challenge = ASCII 'cmd1' followed by SHA-256 of the command without 'signatures' in canonical JSON (RFC 8785, integers only): 36 bytes (decisions #24, #26). freeze needs only the app signature; unfreeze, activate and trust-keys need Admin passkeys."
}
