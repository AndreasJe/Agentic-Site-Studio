# Copy to .env (git-ignored). Placeholder values only.
APP_URL=http://localhost:3000
PREVIEW_URL=http://127.0.0.1:3001
# Absolute path outside the repo and outside OneDrive
DATA_DIR=[absolute path, e.g. C:\site-studio-data]
# At least 32 characters
APP_SECRET=[random string, 32+ characters]
# Generated and logged at startup if empty
INSTANCE_ID=
LLM_BASE_URL=[OpenAI-compatible base URL, e.g. https://host/v1]
LLM_API_KEY=[api key]
LLM_MODEL=[model name]
# json_schema | json_object | none
LLM_CAPABILITY=json_schema
